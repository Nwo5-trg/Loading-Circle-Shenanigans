{
	"geode": "5.9.0",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "nwo5.loading-circle-shenanigans",
	"name": "Loading Circle Shenanigans",
	"version": "v1.0.2",
	"developer": "nwo5",
	"description": "back to developer point grinding i see",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3",
		"nwo5.silly-api": ">=2.0.0",
		"prevter.imageplus": ">=1.1.1",
		"alphalaneous.alphas_geode_utils": ">=1.2.5"
	},
	"tags": ["offline", "customization"],
	"links": {
		"source": "https://github.com/Nwo5-trg/Loading-Circle-Shenanigans",
		"community": "https://discord.gg/AeFeYWGUxZ"
	},
	"resources": {
		"files": [
			"resources/ghidra.gif"
		]
	},
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Enabled",
			"default": true
		},
		"use-custom-image": {
			"type": "bool",
			"name": "Use Custom Image",
			"default": false
		},
		"custom-image": {
			"type": "file",
			"name": "Custom Image",
			"default": "{mod_resources_dir}/ghidra.gif",
			"control": {
				"filters": [
					{
						"files": ["*.png", "*.gif"]
					}
				]
			},
			"enable-if": "use-custom-image"
		},
		"spin": {
			"type": "bool",
			"name": "Spin",
			"default": true
		},
		"scale": {
			"type": "float",
			"name": "Scale",
			"default": 1.0,
			"min": 0.1,
			"max": 5.0
		},
		"speed": {
			"type": "float",
			"name": "Speed",
			"description": "time it takes to do one full rotation",
			"default": 1.0,
			"min": 0.1,
			"max": 10.0
		},
		"color": {
			"type": "rgb",
			"name": "Color",
			"default": "#FFFFFF",
			"enable-if": "!chroma"
		},
		"chroma": {
			"type": "bool",
			"name": "Chroma",
			"default": false
		},
		"chroma-speed": {
			"type": "float",
			"name": "Sayo Device Sensitivity",
			"default": 2.0,
			"min": 0.01,
			"max": 10
		}
	}
}